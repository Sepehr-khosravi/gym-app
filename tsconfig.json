//tsconfig.json
{
    "compilerOptions": {
        "baseUrl": "src/",
        "target": "es5",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "build"
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
